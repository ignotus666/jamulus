QMenuBar {
    background-color: rgb(28, 28, 31);
    color: rgb(220, 220, 220);
    border-bottom: 1px solid rgb(40, 50, 60);
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background: rgb(46, 56, 66);
    color: rgb(236, 240, 246);
}

QMenuBar::item:hover {
    background: rgb(46, 56, 66);
    color: rgb(236, 240, 246);
}

QMenu {
    background-color: rgb(32, 32, 36);
    color: rgb(220, 232, 242);
    border: 1px solid rgb(58, 58, 62);
}

QMenu::item {
    padding: 5px 22px;
}

QMenu::item:hover {
    background-color: rgb(54, 207, 255);
    color: rgb(8, 12, 18);
}

QMenu::item:selected {
    background-color: rgb(54, 207, 255);
    color: rgb(8, 12, 18);
}

QMenu::item:selected:hover {
    background-color: rgb(54, 207, 255);
    color: rgb(8, 12, 18);
}

QLabel {
    color: rgb(220, 220, 220);
}

QGroupBox {
    border: 1px solid rgb(40, 50, 60);
    margin-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: rgb(220, 220, 220);
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    background-color: rgb(37, 37, 40);
    border: 1px solid rgb(88, 88, 92);
    border-radius: 4px;
    color: rgb(220, 232, 242);
    selection-background-color: rgb(54, 207, 255);
    selection-color: rgb(8, 12, 18);
}

QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: rgb(37, 37, 40);
    border: 1px solid rgb(88, 88, 92);
    border-radius: 4px;
    padding: 2px 6px;
    padding-right: 18px;
    color: rgb(220, 232, 242);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid rgb(88, 88, 92);
    background-color: rgb(37, 37, 40);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    image: url(:/styles/down_arrow_dark.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: rgb(37, 37, 40);
    color: rgb(220, 232, 242);
    selection-background-color: rgb(54, 207, 255);
    selection-color: rgb(8, 12, 18);
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgb(52, 52, 56);
    color: rgb(220, 232, 242);
}

QAbstractItemView {
    background-color: rgb(37, 37, 40);
    border: 1px solid rgb(88, 88, 92);
    color: rgb(220, 232, 242);
    selection-background-color: rgb(54, 207, 255);
    selection-color: rgb(8, 12, 18);
}

QTreeWidget,
QTreeView,
QListView,
QTableView {
    background-color: rgb(37, 37, 40);
    color: rgb(220, 232, 242);
    border: 1px solid rgb(88, 88, 92);
    gridline-color: rgb(58, 58, 62);
    alternate-background-color: rgb(44, 44, 48);
    selection-background-color: rgb(54, 207, 255);
    selection-color: rgb(8, 12, 18);
}

QHeaderView::section {
    background-color: rgb(48, 48, 52);
    color: rgb(220, 232, 242);
    border: 1px solid rgb(88, 88, 92);
    padding: 3px 6px;
}

QTabWidget::pane {
    border: 1px solid rgb(40, 50, 60);
    top: -1px;
}

QTabBar::tab {
    background: rgb(38, 38, 42);
    color: rgb(220, 232, 242);
    border: 1px solid rgb(58, 58, 62);
    padding: 4px 10px;
}

QTabBar::tab:selected {
    background: rgb(48, 48, 52);
    border: 1px solid rgb(88, 88, 92);
}

QPushButton {
    color: rgb(220, 232, 242);
    font: bold;
    border: 1px solid rgb(88, 88, 92);
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(54, 54, 58),
                                 stop:1 rgb(38, 38, 42));
    padding: 4px 10px;
}

QPushButton:hover, QToolButton:hover {
    border: 2px solid rgb(54, 207, 255);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(62, 62, 66),
        stop:1 rgb(44, 44, 48));
}

QPushButton:disabled, QToolButton:disabled, QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled, QComboBox:disabled, QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: rgb(96, 104, 112);
    background: rgb(52, 52, 56);
    border-color: rgb(96, 96, 100);
}

QPushButton:disabled:hover, QToolButton:disabled:hover {
    border: 2px solid rgb(54, 207, 255);
}

QCheckBox::indicator:disabled:hover {
    border: 1.5px solid rgb(54, 207, 255);
}

QPushButton:hover {
    border: 2px solid rgb(54, 207, 255);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(62, 62, 66),
                                 stop:1 rgb(44, 44, 48));
}

QPushButton:pressed {
    border: 2px solid rgb(54, 207, 255);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(20, 30, 40),
                                 stop:1 rgb(14, 20, 28));
}

QCheckBox,
QRadioButton {
    color: rgb(220, 220, 220);
    background: transparent;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid rgb(58, 76, 94);
    border-radius: 3px;
    background: rgb(20, 26, 34);
}

QCheckBox::indicator:unchecked {
    image: none;
    background: rgb(20, 26, 34);
}

QCheckBox::indicator:hover {
    border: 1px solid rgb(54, 207, 255);
}

QCheckBox::indicator:checked {
    background: rgb(50, 150, 200);
    border: 1px solid rgb(54, 207, 255);
    image: url(:/styles/checkmark_light.svg);
}

QCheckBox::indicator:unchecked:disabled {
    background: rgb(52, 52, 56);
    border: 1px solid rgb(96, 96, 100);
    image: none;
}

QCheckBox::indicator:checked:disabled {
    background: rgb(72, 120, 155);
    border: 1px solid rgb(100, 110, 120);
    image: url(:/styles/checkmark_light.svg);
}
