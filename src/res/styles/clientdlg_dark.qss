QLabel#lblInputLEDMeter,
QLabel#lblPing,
QLabel#lblPingVal,
QLabel#lblPingUnit,
QLabel#lblDelay,
QLabel#lblDelayVal,
QLabel#lblDelayUnit,
QLabel#lblBuffers {
    font:      bold 11px;
}

QLabel#lblOutput,
QLabel#pOutputBandMeterTitle {
    font:      normal 10px;
}

QLabel[channelLabelStyle="slim"] {
    color: rgb(37, 37, 40);
    background: none;
    font: 9px;
}

QLabel[channelLabelStyle="normal"] {
    color: rgb(37, 37, 40);
    background: none;
    font: bold 9px;
}

QLabel#plblInstrument,
QLabel#plblCountryFlag {
    background: none;
}

QScrollArea,
.QWidget,
QGroupBox {
    background:     transparent;
}

QPushButton#chbLocalMute,
QPushButton#chbSettings,
QPushButton#chbChat,
QPushButton#butEffects {
    color: rgb(75, 213, 248);
    font: bold;
    spacing: 0px;
    padding: 1px 6px;
    border: 1px solid rgb(88, 88, 92);
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(54, 54, 58),
        stop:1 rgb(38, 38, 42));
    min-height: 18px;
    max-height: 18px;
    text-align: center;
    margin: 0px;
}

QPushButton#chbSettings:checked,
QPushButton#chbChat:checked,
QPushButton#butEffects:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(173, 245, 173);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(202, 233, 202),
        stop:1 rgb(173, 245, 173));
}

QPushButton#chbSettings:hover,
QPushButton#chbChat:hover,
QPushButton#butEffects:hover {
    color: rgb(220, 232, 242);
    border: 2px solid rgb(82, 180, 110);
    background: none;
}

QPushButton#chbSettings:checked:hover,
QPushButton#chbChat:checked:hover,
QPushButton#butEffects:checked:hover {
    color: rgb(49, 39, 39);
    border: 2px solid rgb(82, 180, 110);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(222, 240, 222),
        stop:1 rgb(190, 245, 190));
}

QPushButton#chbLocalMute:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(247, 197, 122);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(243, 205, 148),
        stop:1 rgb(247, 197, 122));
}

QPushButton#chbLocalMute:hover {
    color: rgb(220, 232, 242);
    border: 2px solid rgb(247, 197, 122);
    background: none;
}

QPushButton#chbLocalMute:checked:hover {
    color: rgb(49, 39, 39);
    border: 2px solid rgb(240, 207, 158);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(238, 204, 153),
        stop:1 rgb(245, 218, 179));
}

QPushButton#butConnect {
    color:             rgb(75, 213, 248);
    font:              bold;
    border:            2px solid rgb(88, 88, 92);
    border-radius:     6px;
    background:        qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(54, 54, 58),
        stop:1 rgb(38, 38, 42));
    padding:           4px 7px;
}

QPushButton#butConnect[mainConnectButton="true"] {
    min-height:        40px;
    max-height:        40px;
}

QPushButton#butConnect:hover {
    color: rgb(220, 232, 242);
    border: 2px solid rgb(75, 213, 248);
    background: none;
}

QPushButton#butConnect[connectedState="true"] {
    color:             rgb(31, 28, 28);
    border:            2px solid rgb(245, 59, 90);
    background:        qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(240, 145, 156),
        stop:1 rgb(245, 59, 90));
}

QPushButton#butConnect[connectedState="true"]:hover {
    color: rgb(31, 28, 28);
    border:            2px solid rgb(222, 88, 96);
    background:        qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(243, 202, 207),
        stop:1 rgb(241, 93, 118));
}

/* Mixer strip buttons */

QPushButton#pcbGroup,
QPushButton#pcbMute,
QPushButton#pcbSolo {
    color: rgb(220, 232, 242);
    font: bold;
    spacing: 0px;
    padding: 4px 5px;
    border: 1px solid rgb(88, 88, 92);
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(54, 54, 58),
        stop:1 rgb(38, 38, 42));
    min-height: 16px;
    max-height: 16px;
    text-align: center;
    margin: 0px;
}

QPushButton#pcbGroup[groupColorIdx="0"]:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(196, 58, 197);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(226, 169, 227),
        stop:1 rgb(196, 58, 197));
}

QPushButton#pcbGroup[groupColorIdx="1"]:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(43, 147, 212);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(165, 214, 245),
        stop:1 rgb(43, 147, 212));
}

QPushButton#pcbGroup[groupColorIdx="2"]:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(59, 197, 58);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(179, 237, 179),
        stop:1 rgb(59, 197, 58));
}

QPushButton#pcbGroup[groupColorIdx="3"]:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(212, 108, 43);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(238, 192, 163),
        stop:1 rgb(212, 108, 43));
}

QPushButton#pcbGroup[groupSegmented="1"][groupColorIdx="0"]:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(196, 58, 197);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0.00 rgb(236, 198, 237), stop:0.16 rgb(236, 198, 237),
        stop:0.17 rgb(196, 58, 197),  stop:0.33 rgb(196, 58, 197),
        stop:0.34 rgb(236, 198, 237), stop:0.50 rgb(236, 198, 237),
        stop:0.51 rgb(196, 58, 197),  stop:0.67 rgb(196, 58, 197),
        stop:0.68 rgb(236, 198, 237), stop:0.84 rgb(236, 198, 237),
        stop:0.85 rgb(196, 58, 197),  stop:1.00 rgb(196, 58, 197));
}

QPushButton#pcbGroup[groupSegmented="1"][groupColorIdx="1"]:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(43, 147, 212);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0.00 rgb(193, 228, 248), stop:0.16 rgb(193, 228, 248),
        stop:0.17 rgb(43, 147, 212),  stop:0.33 rgb(43, 147, 212),
        stop:0.34 rgb(193, 228, 248), stop:0.50 rgb(193, 228, 248),
        stop:0.51 rgb(43, 147, 212),  stop:0.67 rgb(43, 147, 212),
        stop:0.68 rgb(193, 228, 248), stop:0.84 rgb(193, 228, 248),
        stop:0.85 rgb(43, 147, 212),  stop:1.00 rgb(43, 147, 212));
}

QPushButton#pcbGroup[groupSegmented="1"][groupColorIdx="2"]:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(59, 197, 58);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0.00 rgb(205, 245, 205), stop:0.16 rgb(205, 245, 205),
        stop:0.17 rgb(59, 197, 58),   stop:0.33 rgb(59, 197, 58),
        stop:0.34 rgb(205, 245, 205), stop:0.50 rgb(205, 245, 205),
        stop:0.51 rgb(59, 197, 58),   stop:0.67 rgb(59, 197, 58),
        stop:0.68 rgb(205, 245, 205), stop:0.84 rgb(205, 245, 205),
        stop:0.85 rgb(59, 197, 58),   stop:1.00 rgb(59, 197, 58));
}

QPushButton#pcbGroup[groupSegmented="1"][groupColorIdx="3"]:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(212, 108, 43);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0.00 rgb(245, 219, 201), stop:0.16 rgb(245, 219, 201),
        stop:0.17 rgb(212, 108, 43),  stop:0.33 rgb(212, 108, 43),
        stop:0.34 rgb(245, 219, 201), stop:0.50 rgb(245, 219, 201),
        stop:0.51 rgb(212, 108, 43),  stop:0.67 rgb(212, 108, 43),
        stop:0.68 rgb(245, 219, 201), stop:0.84 rgb(245, 219, 201),
        stop:0.85 rgb(212, 108, 43),  stop:1.00 rgb(212, 108, 43));
}

QPushButton#pcbGroup:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(59, 164, 245);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(151, 202, 241),
        stop:1 rgb(59, 164, 245));
}

QPushButton#pcbGroup:hover {
    border: 2px solid rgb(59, 164, 245);
    background: none;
}

QPushButton#pcbGroup:checked:hover {
    border: 2px solid rgb(125, 198, 240);
    background:    qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(167, 219, 240),
        stop:1 rgb(125, 198, 240));
}

QPushButton#pcbGroup[groupColorIdx="0"]:checked:hover {
    border: 2px solid rgb(214, 132, 214);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(237, 210, 237),
        stop:1 rgb(214, 132, 214));
}

QPushButton#pcbGroup[groupColorIdx="1"]:checked:hover {
    border: 2px solid rgb(117, 190, 236);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(202, 229, 246),
        stop:1 rgb(117, 190, 236));
}

QPushButton#pcbGroup[groupColorIdx="2"]:checked:hover {
    border: 2px solid rgb(132, 214, 132);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(218, 246, 218),
        stop:1 rgb(132, 214, 132));
}

QPushButton#pcbGroup[groupColorIdx="3"]:checked:hover {
    border: 2px solid rgb(227, 160, 118);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(247, 223, 206),
        stop:1 rgb(227, 160, 118));
}

QPushButton#pcbGroup[groupSegmented="1"][groupColorIdx="0"]:checked:hover {
    border: 2px solid rgb(214, 132, 214);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0.00 rgb(246, 228, 246), stop:0.16 rgb(246, 228, 246),
        stop:0.17 rgb(214, 132, 214), stop:0.33 rgb(214, 132, 214),
        stop:0.34 rgb(246, 228, 246), stop:0.50 rgb(246, 228, 246),
        stop:0.51 rgb(214, 132, 214), stop:0.67 rgb(214, 132, 214),
        stop:0.68 rgb(246, 228, 246), stop:0.84 rgb(246, 228, 246),
        stop:0.85 rgb(214, 132, 214), stop:1.00 rgb(214, 132, 214));
}

QPushButton#pcbGroup[groupSegmented="1"][groupColorIdx="1"]:checked:hover {
    border: 2px solid rgb(117, 190, 236);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0.00 rgb(223, 241, 252), stop:0.16 rgb(223, 241, 252),
        stop:0.17 rgb(117, 190, 236), stop:0.33 rgb(117, 190, 236),
        stop:0.34 rgb(223, 241, 252), stop:0.50 rgb(223, 241, 252),
        stop:0.51 rgb(117, 190, 236), stop:0.67 rgb(117, 190, 236),
        stop:0.68 rgb(223, 241, 252), stop:0.84 rgb(223, 241, 252),
        stop:0.85 rgb(117, 190, 236), stop:1.00 rgb(117, 190, 236));
}

QPushButton#pcbGroup[groupSegmented="1"][groupColorIdx="2"]:checked:hover {
    border: 2px solid rgb(132, 214, 132);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0.00 rgb(228, 252, 228), stop:0.16 rgb(228, 252, 228),
        stop:0.17 rgb(132, 214, 132), stop:0.33 rgb(132, 214, 132),
        stop:0.34 rgb(228, 252, 228), stop:0.50 rgb(228, 252, 228),
        stop:0.51 rgb(132, 214, 132), stop:0.67 rgb(132, 214, 132),
        stop:0.68 rgb(228, 252, 228), stop:0.84 rgb(228, 252, 228),
        stop:0.85 rgb(132, 214, 132), stop:1.00 rgb(132, 214, 132));
}

QPushButton#pcbGroup[groupSegmented="1"][groupColorIdx="3"]:checked:hover {
    border: 2px solid rgb(227, 160, 118);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0.00 rgb(252, 236, 225), stop:0.16 rgb(252, 236, 225),
        stop:0.17 rgb(227, 160, 118), stop:0.33 rgb(227, 160, 118),
        stop:0.34 rgb(252, 236, 225), stop:0.50 rgb(252, 236, 225),
        stop:0.51 rgb(227, 160, 118), stop:0.67 rgb(227, 160, 118),
        stop:0.68 rgb(252, 236, 225), stop:0.84 rgb(252, 236, 225),
        stop:0.85 rgb(227, 160, 118), stop:1.00 rgb(227, 160, 118));
}

QPushButton#pcbMute:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(243, 110, 132);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(245, 188, 195),
        stop:1 rgb(243, 110, 132));
}

QPushButton#pcbMute:hover {
    border: 2px solid rgb(243, 110, 132);
    background: none;
}

QPushButton#pcbMute:checked:hover {
    border: 1px solid rgb(243, 109, 149);
    background:    qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(243, 205, 219),
        stop:1 rgb(236, 144, 172));
}

QPushButton#pcbSolo:checked {
    color: rgb(31, 28, 28);
    border: 2px solid rgb(220, 163, 240);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(235, 204, 235),
        stop:1 rgb(220, 163, 240));
}

QPushButton#pcbSolo:hover {
    border: 2px solid rgb(220, 163, 240);
    background: none;
}

QPushButton#pcbSolo:checked:hover {
    border: 1px solid rgb(231, 201, 241);
    background:    qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(243, 227, 243),
        stop:1 rgb(236, 200, 240));
}