QMenuBar {
    background-color: rgb(247, 248, 250);
    color: rgb(28, 34, 42);
    border-bottom: 1px solid rgb(196, 202, 210);
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background: rgb(232, 240, 250);
    color: rgb(28, 34, 42);
}

QMenuBar::item:hover {
    background: rgb(232, 240, 250);
    color: rgb(28, 34, 42);
}

QMenu {
    background-color: rgb(255, 255, 255);
    color: rgb(28, 34, 42);
    border: 1px solid rgb(180, 188, 198);
}

QMenu::item {
    padding: 5px 22px;
}

QMenu::item:hover {
    background-color: rgb(198, 220, 245);
    color: rgb(28, 34, 42);
}

QMenu::item:selected {
    background-color: rgb(46, 132, 198);
    color: rgb(255, 255, 255);
}

QMenu::item:selected:hover {
    background-color: rgb(198, 220, 245);
    color: rgb(28, 34, 42);
}

QLabel {
    color: rgb(28, 34, 42);
}

QGroupBox {
    border: 1px solid rgb(196, 202, 210);
    margin-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: rgb(28, 34, 42);
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    background-color: rgb(255, 255, 255);
    border: 1px solid rgb(180, 188, 198);
    border-radius: 4px;
    color: rgb(28, 34, 42);
    selection-background-color: rgb(46, 132, 198);
    selection-color: rgb(255, 255, 255);
}

QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: rgb(255, 255, 255);
    border: 1px solid rgb(180, 188, 198);
    border-radius: 4px;
    padding: 2px 6px;
    padding-right: 18px;
    color: rgb(28, 34, 42);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid rgb(180, 188, 198);
    background-color: rgb(255, 255, 255);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    image: url(:/styles/down_arrow_light.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: rgb(255, 255, 255);
    color: rgb(28, 34, 42);
    selection-background-color: rgb(46, 132, 198);
    selection-color: rgb(255, 255, 255);
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgb(142, 188, 233);
    color: rgb(28, 34, 42);
}

QAbstractItemView {
    background-color: rgb(255, 255, 255);
    border: 1px solid rgb(180, 188, 198);
    color: rgb(28, 34, 42);
    selection-background-color: rgb(46, 132, 198);
    selection-color: rgb(255, 255, 255);
}

QTreeWidget,
QTreeView,
QListView,
QTableView {
    background-color: rgb(255, 255, 255);
    color: rgb(28, 34, 42);
    border: 1px solid rgb(180, 188, 198);
    gridline-color: rgb(220, 225, 233);
    alternate-background-color: rgb(246, 248, 252);
    selection-background-color: rgb(46, 132, 198);
    selection-color: rgb(255, 255, 255);
}

QHeaderView::section {
    background-color: rgb(242, 244, 248);
    color: rgb(28, 34, 42);
    border: 1px solid rgb(196, 202, 210);
    padding: 3px 6px;
}

QTabWidget::pane {
    border: 1px solid rgb(196, 202, 210);
    top: -1px;
}

QTabBar::tab {
    background: rgb(242, 244, 248);
    color: rgb(28, 34, 42);
    border: 1px solid rgb(196, 202, 210);
    padding: 4px 10px;
}

QTabBar::tab:selected {
    background: rgb(255, 255, 255);
    border: 1px solid rgb(180, 188, 198);
}

QPushButton {
    color: rgb(28, 34, 42);
    font: bold;
    border: 1px solid rgb(180, 188, 198);
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(255, 255, 255),
                                 stop:1 rgb(232, 236, 242));
    padding: 4px 10px;
}

QPushButton:hover, QToolButton:hover {
    border: 2px solid rgb(46, 132, 198);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgb(246, 249, 252),
        stop:1 rgb(220, 227, 236));
}

QPushButton:disabled, QToolButton:disabled, QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled, QComboBox:disabled, QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: rgb(166, 176, 188);
    background: rgb(245, 247, 250);
    border-color: rgb(205, 210, 218);
}

QPushButton:disabled:hover, QToolButton:disabled:hover {
    border: 2px solid rgb(46, 132, 198);
}

QCheckBox::indicator:disabled:hover {
    border: 1.5px solid rgb(46, 132, 198);
}

QPushButton:hover {
    border: 2px solid rgb(46, 132, 198);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(246, 249, 252),
                                 stop:1 rgb(220, 227, 236));
}

QPushButton:pressed {
    border: 2px solid rgb(46, 132, 198);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(224, 230, 238),
                                 stop:1 rgb(208, 216, 226));
}

QCheckBox,
QRadioButton {
    color: rgb(28, 34, 42);
    background: transparent;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid rgb(165, 175, 185);
    border-radius: 3px;
    background: rgb(255, 255, 255);
}

QCheckBox::indicator:unchecked {
    image: none;
    background: rgb(255, 255, 255);
}

QCheckBox::indicator:hover {
    border: 1px solid rgb(46, 132, 198);
}

QCheckBox::indicator:checked {
    background: rgb(50, 150, 200);
    border: 1px solid rgb(46, 132, 198);
    image: url(:/styles/checkmark_light.svg);
}

QCheckBox::indicator:unchecked:disabled {
    background: rgb(245, 247, 250);
    border: 1px solid rgb(205, 210, 218);
    image: none;
}

QCheckBox::indicator:checked:disabled {
    background: rgb(120, 170, 205);
    border: 1px solid rgb(130, 145, 160);
    image: url(:/styles/checkmark_light.svg);
}
