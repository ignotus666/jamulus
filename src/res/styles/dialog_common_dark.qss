QCheckBox::indicator:hover {
    border: 1.5px solid rgb(54, 207, 255);
}
QPushButton:disabled {
    background: rgb(46, 46, 50);
    color: rgb(96, 96, 100);
    border: 1px solid rgb(96, 96, 100);
}
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    color: rgb(96, 96, 100);
    background-color: rgb(46, 46, 50);
    border: 1px solid rgb(96, 96, 100);
}

QLabel:disabled {
    color: rgb(96, 96, 100);
}

QGroupBox::title:disabled {
    color: rgb(96, 96, 100);
}
QDialog,
QWidget {
    background-color: rgb(28, 28, 31);
    color: rgb(220, 220, 220);
}

QLabel {
    color: rgb(220, 220, 220);
}

QGroupBox {
    border: 1px solid rgb(40, 50, 60);
    margin-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: rgb(220, 220, 220);
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    background-color: rgb(37, 37, 40);
    border: 1px solid rgb(88, 88, 92);
    border-radius: 4px;
    color: rgb(220, 232, 242);
    selection-background-color: rgb(54, 207, 255);
    selection-color: rgb(8, 12, 18);
}

QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: rgb(37, 37, 40);
    border: 1px solid rgb(88, 88, 92);
    border-radius: 4px;
    padding: 2px 6px;
    padding-right: 18px;
    color: rgb(220, 232, 242);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid rgb(88, 88, 92);
    background-color: rgb(37, 37, 40);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    image: url(:/styles/down_arrow_dark.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: rgb(37, 37, 40);
    color: rgb(220, 232, 242);
    selection-background-color: rgb(54, 207, 255);
    selection-color: rgb(8, 12, 18);
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgb(52, 52, 56);
    color: rgb(220, 232, 242);
}

QAbstractItemView {
    background-color: rgb(37, 37, 40);
    border: 1px solid rgb(88, 88, 92);
    color: rgb(220, 232, 242);
    selection-background-color: rgb(54, 207, 255);
    selection-color: rgb(8, 12, 18);
}

QTreeWidget,
QTreeView,
QListView,
QTableView {
    background-color: rgb(37, 37, 40);
    color: rgb(220, 232, 242);
    border: 1px solid rgb(88, 88, 92);
    gridline-color: rgb(58, 58, 62);
    alternate-background-color: rgb(44, 44, 48);
    selection-background-color: rgb(54, 207, 255);
    selection-color: rgb(8, 12, 18);
}

QTreeWidget::item:hover,
QTreeView::item:hover,
QListView::item:hover,
QTableView::item:hover {
    background: rgb(52, 52, 56);
    color: rgb(220, 232, 242);
}

QTreeWidget::item:selected,
QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background: rgb(54, 207, 255);
    color: rgb(8, 12, 18);
}

QHeaderView::section {
    background-color: rgb(38, 38, 42);
    color: rgb(220, 232, 242);
    border: 1px solid rgb(58, 58, 62);
    padding: 2px 6px;
}

QTreeWidget::indicator,
QTreeView::indicator,
QListView::indicator,
QTableView::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid rgb(88, 88, 92);
    border-radius: 3px;
    background: rgb(37, 37, 40);
}

QTreeWidget::indicator:unchecked,
QTreeView::indicator:unchecked,
QListView::indicator:unchecked,
QTableView::indicator:unchecked {
    image: none;
    background: rgb(37, 37, 40);
}

QTreeWidget::indicator:checked,
QTreeView::indicator:checked,
QListView::indicator:checked,
QTableView::indicator:checked {
    background: rgb(50, 150, 200);
    border: 1px solid rgb(54, 207, 255);
    image: url(:/styles/checkmark_light.svg);
}

QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    border: 1px solid rgb(70, 100, 130);
    border-radius: 3px;
    background: rgb(40, 50, 60);
}

QSlider::groove:vertical {
    width: 6px;
    border: 1px solid rgb(70, 100, 130);
    border-radius: 3px;
    background: rgb(40, 50, 60);
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 rgb(118, 244, 255),
                                 stop:0.55 rgb(80, 220, 255),
                                 stop:1 rgb(40, 160, 220));
    border-radius: 3px;
}

QSlider::sub-page:vertical {
    background: rgb(58, 58, 62);
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: rgb(58, 58, 62);
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                 stop:0 rgb(118, 244, 255),
                                 stop:0.55 rgb(80, 220, 255),
                                 stop:1 rgb(40, 160, 220));
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(82, 96, 112),
                                 stop:1 rgb(28, 36, 46));
    border: 1px solid rgb(92, 108, 124);
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
    transition: border 0.2s;
}
QSlider::handle:horizontal:hover {
    border: 2px solid rgb(54, 207, 255);
}

QSlider::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(82, 96, 112),
                                 stop:1 rgb(28, 36, 46));
    border: 1px solid rgb(92, 108, 124);
    height: 14px;
    margin: 0 -6px;
    border-radius: 7px;
    transition: border 0.2s;
}
QSlider::handle:vertical:hover {
    border: 2px solid rgb(54, 207, 255);
}

QCheckBox,
QRadioButton {
    color: rgb(220, 220, 220);
    background: transparent;
    spacing: 6px;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: rgb(96, 96, 100);
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid rgb(88, 88, 92);
    border-radius: 3px;
    background: rgb(37, 37, 40);
}

QCheckBox::indicator:unchecked {
    image: none;
    background: rgb(37, 37, 40);
}

QCheckBox::indicator:hover {
    border: 1px solid rgb(54, 207, 255);
}

QCheckBox::indicator:checked {
    background: rgb(50, 150, 200);
    image: url(:/styles/checkmark_light.svg);
}

QCheckBox::indicator:checked:disabled {
    background: rgb(72, 120, 155);
    border: 1px solid rgb(100, 110, 120);
    image: url(:/styles/checkmark_light.svg);
}

QCheckBox::indicator:unchecked:disabled {
    background: rgb(52, 52, 56);
    border: 1px solid rgb(96, 96, 100);
    image: none;
}

QCheckBox::indicator:disabled {
    background: rgb(46, 46, 50);
    border: 1px solid rgb(96, 96, 100);
}

QCheckBox::indicator:disabled:hover {
    border: 1.5px solid rgb(54, 207, 255);
    background: rgb(46, 46, 50);
}

QGroupBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid rgb(88, 88, 92);
    border-radius: 3px;
    background: rgb(37, 37, 40);
}

QGroupBox::indicator:unchecked {
    image: none;
    background: rgb(37, 37, 40);
}

QGroupBox::indicator:checked {
    background: rgb(50, 150, 200);
    border: 1px solid rgb(54, 207, 255);
    image: url(:/styles/checkmark_light.svg);
}

QTabWidget::pane {
    border: 1px solid rgb(58, 58, 62);
    top: -1px;
}

QTabBar::tab {
    background: rgb(38, 38, 42);
    color: rgb(220, 232, 242);
    border: 1px solid rgb(58, 58, 62);
    padding: 4px 10px;
}

QTabBar::tab:selected {
    background: rgb(48, 48, 52);
    border: 1px solid rgb(88, 88, 92);
}

QMenuBar {
    background-color: rgb(28, 28, 31);
    color: rgb(220, 232, 242);
    border: 1px solid rgb(58, 58, 62);
}

QMenuBar::item {
    background: transparent;
    color: rgb(220, 232, 242);
    padding: 3px 8px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background: rgb(52, 52, 56);
    color: rgb(220, 232, 242);
}

QMenu {
    background-color: rgb(37, 37, 40);
    color: rgb(220, 232, 242);
    border: 1px solid rgb(88, 88, 92);
}

QMenu::item {
    padding: 4px 16px;
    background: transparent;
}

QMenu::item:selected {
    background: rgb(52, 52, 56);
    color: rgb(220, 232, 242);
}

QMenu::separator {
    height: 1px;
    background: rgb(58, 58, 62);
    margin: 4px 8px;
}
QMenuBar::item:hover {
    background: rgb(52, 52, 56);
    color: rgb(220, 232, 242);
}
QMenu::item:hover {
    background: rgb(60, 60, 65);
    color: rgb(220, 232, 242);
}
QMenu::item:selected:hover {
    background: rgb(60, 60, 65);
    color: rgb(220, 232, 242);
}

QPushButton {
    color: rgb(220, 232, 242);
    font: bold;
    border: 2px solid rgb(88, 88, 92);
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(54, 54, 58),
                                 stop:1 rgb(38, 38, 42));
    padding: 3px 9px;
    min-height: 22px;
}


QPushButton:hover {
    border: 2px solid rgb(54, 207, 255);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(62, 62, 66),
                                 stop:1 rgb(44, 44, 48));
}

QPushButton:pressed {
    border: 2px solid rgb(54, 207, 255);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(40, 40, 44),
                                 stop:1 rgb(28, 28, 32));
}

QToolButton {
    color: rgb(220, 232, 242);
    font: bold;
    border: 1px solid rgb(88, 88, 92);
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(54, 54, 58),
                                 stop:1 rgb(38, 38, 42));
    padding: 2px 6px;
}

QToolButton:hover {
    border: 2px solid rgb(54, 207, 255);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(62, 62, 66),
                                 stop:1 rgb(44, 44, 48));
}

QToolButton:pressed {
    border: 2px solid rgb(54, 207, 255);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 rgb(40, 40, 44),
                                 stop:1 rgb(28, 28, 32));
}
